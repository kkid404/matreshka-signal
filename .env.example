# Telegram Bot Configuration
# 1. Создайте бота через @BotFather в Telegram → получите токен
# 2. Узнайте свой chat_id через @userinfobot или @RawDataBot
# 3. Скопируйте этот файл в .env и заполните значения

TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ENABLED=true

# Optional: Telegram Replay Bot settings
# Comma-separated Telegram user IDs allowed to run bot commands.
# Leave empty to allow everyone who can write to the bot.
TELEGRAM_ALLOWED_USER_IDS=

# Enable debug logs for bot process
BOT_DEBUG=false

# Internal service URLs (docker-compose defaults)
NOTIFICATION_SERVICE_URL=http://notification-service:8081
SIGNAL_ENGINE_SERVICE_URL=http://signal-engine:8082
MARKET_DATA_SERVICE_URL=http://market-data:8083
ANALYTICS_SERVICE_URL=http://analytics:8084

# Optional service bind settings (for dedicated service containers)
NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=8081
SIGNAL_ENGINE_SERVICE_HOST=0.0.0.0
SIGNAL_ENGINE_SERVICE_PORT=8082
MARKET_DATA_SERVICE_HOST=0.0.0.0
MARKET_DATA_SERVICE_PORT=8083
ANALYTICS_SERVICE_HOST=0.0.0.0
ANALYTICS_SERVICE_PORT=8084

# Market-data service cache/rate-limit controls
MARKET_DATA_CACHE_TTL_SECONDS=120
MARKET_DATA_MIN_REQUEST_INTERVAL_MS=200
